root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.sh]
shell_variant = bash
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true

[justfile]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[LICENSE]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
max_line_length = unset
