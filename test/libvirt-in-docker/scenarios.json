    "features": {
      "libvirt-in-docker": {
        "swtpm": true
      }
    }
  },
  "test_restart_by_hand": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu24.04",
    "remoteUser": "vscode",
    "features": {
      "libvirt-in-docker": {}
    }
  },
  "fail_install": {
    "image": "debian:13",
    "features": {
      "libvirt-in-docker": {}
    }
  }
}
